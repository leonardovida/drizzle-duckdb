{
  "name": "@duckdbfan/drizzle-duckdb",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "version": "3.0.0-rc.1",
  "description": "A drizzle ORM client for use with DuckDB. Based on drizzle's Postgres client.",
  "type": "module",
  "scripts": {
    "build": "bun build --target=node ./src/index.ts --outfile=./dist/index.mjs --packages=external && bun build --target=node ./src/helpers.ts --outfile=./dist/helpers.mjs --packages=external && bun build --target=node ./src/bin/duckdb-introspect.ts --outfile=./dist/duckdb-introspect.mjs --packages=external && bun run build:declarations",
    "build:declarations": "bun x tsc --emitDeclarationOnly --project tsconfig.types.json",
    "test": "bun x vitest run",
    "test:coverage": "bun x vitest run --coverage",
    "typecheck": "bun x tsc --noEmit --project tsconfig.check.json && bun x tsc --noEmit --project tsconfig.workspace.json",
    "check:package": "bun run scripts/check-package.ts",
    "check:peer-range": "bun run scripts/check-peer-range.ts",
    "t": "bun x vitest --watch --ui",
    "bench": "bun x vitest bench --run test/perf --pool=threads --maxWorkers=1 --no-file-parallelism",
    "perf:run": "bun run scripts/run-perf.ts",
    "perf:compare": "bun run scripts/compare-perf.ts"
  },
  "bin": {
    "duckdb-introspect": "dist/duckdb-introspect.mjs"
  },
  "peerDependencies": {
    "@duckdb/node-api": ">=1.4.4 <1.6.0 || >=1.4.4-r.1 <1.4.5 || >=1.4.5-r.1 <1.4.6 || >=1.5.0-r.1 <1.5.1 || >=1.5.1-r.1 <1.5.2 || >=1.5.2-r.1 <1.5.3 || >=1.5.3-r.1 <1.5.4 || >=1.5.4-r.1 <1.5.5 || >=1.5.5-r.1 <1.5.6 || >=1.5.6-r.1 <1.5.7",
    "drizzle-orm": ">=1.0.0-rc.5 <=1.0.0-rc.99 || >=1.0.0 <2.0.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.2",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "drizzle-orm": "1.0.0-rc.5",
    "prettier": "3.10.1",
    "semver": "7.8.6",
    "typescript": "7.0.2",
    "uuid": "14.0.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardovida/drizzle-duckdb.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.mjs",
      "default": "./dist/helpers.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "bun@1.4.4",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "duckdb",
    "motherduck",
    "ducklake",
    "orm",
    "sql",
    "typescript",
    "analytics",
    "olap"
  ],
  "author": "M L",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/leonardovida/drizzle-duckdb/issues"
  },
  "homepage": "https://github.com/leonardovida/drizzle-duckdb#readme",
  "files": [
    "dist/*.mjs",
    "dist/**/*.d.ts"
  ],
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "vite": "8.1.4"
  },
  "dependencies": {
    "node-sql-parser": "^5.4.0"
  }
}
